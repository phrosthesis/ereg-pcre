{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "phrosthesis/ereg-pcre",
    "description": "Prosthesis for ereg on top of PCRE.",
    "keywords": ["ereg", "polyfill", "legacy", "pcre", "php5", "php7", "deprecated"],
    "type": "library",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Alexey Tsarkov"
        }
    ],
    "support": {
        "issues": "https://github.com/phrosthesis/ereg-pcre/issues",
        "source": "https://github.com/phrosthesis/ereg-pcre"
    },
    "autoload": {
        "psr-4": {
            "Phrosthesis\\Ereg\\": "src/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "require": {
        "php": ">=7.0",
        "ext-pcre": "*"
    },
    "require-dev": {
        "phrosthesis/run-tests": "*"
    },
    "conflict": {
        "phrosthesis/ereg-mbstring": "*"
    },
    "extra": {
        "branch-alias": {
            "main": "0.x-dev"
        }
    },
    "scripts": {
        "run-tests": [
            "Composer\\Config::disableProcessTimeout",
            "@php run-tests.php -P -q -d auto_prepend_file=vendor/autoload.php"
        ]
    },
    "scripts-aliases": {
        "run-tests": ["test"]
    },
    "scripts-descriptions": {
        "run-tests": "Runs the tests"
    },
    "config": {
        "allow-plugins": {
            "phrosthesis/run-tests": true
        }
    }
}
