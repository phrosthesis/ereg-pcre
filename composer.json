{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "phrosthesis/ereg-pcre",
    "description": "Prosthesis for ereg on top of PCRE.",
    "keywords": ["ereg", "polyfill", "legacy", "pcre", "php5", "php7", "deprecated"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexey Tsarkov",
            "email": "alex.tsarkov@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Phrosthesis\\Ereg\\": "src/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "require": {
        "php": ">=7.0",
        "ext-pcre": "*"
    },
    "conflict": {
        "phrosthesis/ereg-mbstring": "*"
    },
    "extra": {
        "branch-alias": {
            "main": "0.x-dev"
        }
    }
}
